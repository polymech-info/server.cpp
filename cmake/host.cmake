# Host translation units. They include the desktop CLI, the agent, and Win32.
# The library does not compile them. A host calls these after it exists.
# Source lists live in sources.cmake.

if(COMMAND pm_server_add_lan)
  return()
endif()
if(NOT PM_SERVER_ROOT)
  get_filename_component(PM_SERVER_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
include("${PM_SERVER_ROOT}/cmake/sources.cmake")

# Folder bookmarks. The settings store stays on the host, so this file is
# not part of pm-server-lib.
function(pm_server_add_bookmarks target)
  if(NOT TARGET ${target})
    return()
  endif()
  pm_server_bookmark_sources(_sources)
  target_sources(${target} PRIVATE ${_sources})
endfunction()

function(pm_server_add_lan target)
  if(NOT TARGET ${target})
    return()
  endif()
  pm_server_lan_sources(_sources)
  target_sources(${target} PRIVATE ${_sources})
endfunction()

function(pm_server_add_desktop_core target)
  if(NOT TARGET ${target})
    return()
  endif()
  get_target_property(_srcs ${target} SOURCES)
  if(_srcs MATCHES "lifecycle/desktop\\.cpp")
    return()
  endif()
  pm_server_desktop_core_sources(_core)
  target_sources(${target} PRIVATE ${_core})
endfunction()

function(pm_server_add_desktop_node target)
  if(NOT TARGET ${target})
    return()
  endif()
  pm_server_add_desktop_core(${target})
  get_target_property(_srcs ${target} SOURCES)
  if(_srcs MATCHES "routes/node_serve\\.cpp")
    return()
  endif()
  _pm_server_root(_root)
  target_sources(${target} PRIVATE "${_root}/src/node-core/routes/node_serve.cpp")
endfunction()

function(pm_server_add_mdns target)
  if(NOT TARGET ${target})
    return()
  endif()
  get_target_property(_srcs ${target} SOURCES)
  if(_srcs MATCHES "mdns_win\\.cpp|mdns_stub\\.cpp")
    return()
  endif()
  pm_server_mdns_sources(_sources)
  target_sources(${target} PRIVATE ${_sources})
endfunction()
